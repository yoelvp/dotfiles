@import "shared/colors.rasi"
@import "shared/fonts.rasi"

/*****----- Configuration -----*****/
configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    hide-scrollbar: false;
    listview-striped: false;
    sidebar-mode: false;
}

/*****----- Main Window -----*****/
window {
    transparency:"real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 25%;
    x-offset: 0px;
    y-offset: 0px;

    /* properties for all widgets */
    border: 0;
    padding: 0;
    enabled: true;
    cursor: "default";
    background-color: @bg;
}

/*****----- Main Box -----*****/
mainbox {
    orientation: vertical;
    children: [inputbar, listview];
}

/*****----- Inputbar -----*****/
textbox-prompt-colon {
    enabled: true;
    str: " ";
    text-color: #d5c4a1;
}

entry {
    enabled: true;
    text-color: inherit;
    cursor: text;
    placeholder: "Search...";
    placeholder-color: #d5c4a1;
}

inputbar {
    enabled: true;
    spacing: 4px;
    text-color: @fg;
    background-color: @selected;
    padding: 16px;
    children: ["textbox-prompt-colon", "entry"];
}

/*****----- Listview -----*****/
listview {
    columns: 1;
    lines:   6;
    cycle:   true;
    dynamic: true;
    listview-striped: false;
    layout: vertical;
    reverse: false;
    spacing: 10px;
    text-color: @fg;
}

/*****----- Elements -----*****/
element {
    enabled: true;
    padding: 8px 16px;
    background-color: @bg-alt;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal {
    background-color: inherit;
    text-color: inherit;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element alternate.normal {
    background-color: @transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 48px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/***** Scrollbar *****/
scrollbar {
    width: 4px;
    handle-width: 4px;
    border: 0;
    handle-color: @bg-alt;
    handle-radius: 4px;
    border-radius: 4px;
}

@import "../shared/colors.rasi"
@import "../shared/fonts.rasi"

/*****----- Configuration -----*****/
configuration {
    modi: "calc";
    show-icons: false;
    listview-striped: false;
}

/*****----- Main Window -----*****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 30%;
    x-offset: 0;
    y-offset: 0;
    enabled: true;
    cursor: "default";
    background-color: @bg;
}

/*****----- Main Box -----*****/
mainbox {
    orientation: vertical;
    children: [inputbar, listview];
    background-color: inherit;
}

/*****----- Inputbar -----*****/
textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: " ";
    text-color: #d5c4a1;
    background-color: inherit;
}

entry {
    enabled: true;
    text-color: inherit;
    cursor: text;
    placeholder: "Enter operation...";
    placeholder-color: #d5c4a1;
    background-color: inherit;
}

inputbar {
    enabled: true;
    spacing: 4px;
    text-color: @fg;
    background-color: @selected;
    padding: 16px;
    children: ["textbox-prompt-colon", "entry"];
}

/*****----- Listview -----*****/
listview {
    background-color: transparent;
    columns: 1;
    lines:   8;
    cycle:   true;
    dynamic: true;
    listview-striped: false;
    layout: vertical;
    reverse: false;
    text-color: @fg;
}

/*****----- Elements -----*****/
element {
    enabled: true;
    padding: 16px 32px;
    background-color: transparent;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal {
    background-color: inherit;
    text-color: inherit;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

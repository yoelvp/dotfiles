@import "../shared/colors.rasi"
@import "../shared/fonts.rasi"

/*****----- Configuration -----*****/
configuration {
    modi: "clipboard:greenclip print";
    show-icons: false;
    drun-display-format: "{name}";
    hide-scrollbar: false;
    listview-striped: false;
}

/*****----- Main Window -----*****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 40%;
    x-offset: 0;
    y-offset: 0;
    enabled: true;
    cursor: "default";
    background-color: @bg;
}

/*****----- Main Box -----*****/
mainbox {
    orientation: vertical;
    children: [textbox, listview];
    background-color: inherit;
}

/*****----- Header -----*****/
textbox {
    expand: false;
    content: " Clipboard";
    padding: 16px;
    text-color: @fg;
    background-color: @selected;
}

/*****----- Listview -----*****/
listview {
    background-color: transparent;
    columns: 1;
    lines:   8;
    cycle:   true;
    dynamic: true;
    listview-striped: false;
    hide-scrollbar: false;
    layout: vertical;
    reverse: false;
    text-color: @fg;
}

/*****----- Elements -----*****/
element {
    enabled: true;
    padding: 16px 32px;
    background-color: transparent;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal {
    background-color: inherit;
    text-color: inherit;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/*****----- Scrollbar -----*****/
scrollbar {
    enabled: true;
    width: 6px;
    handle-width: 8px;
    border: 0;
    handle-color: @bg-alt;
    handle-radius: 4px;
    border-radius: 4px;
}
